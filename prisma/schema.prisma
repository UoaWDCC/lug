// This is the Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id Int @id @default(autoincrement())

  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  role Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id String @id @default(cuid())

  title   String
  slug    String  @unique
  excerpt String?
  content String

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  tags     BlogTag[]
  imageUrl String?

  authorName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum BlogTag {
  ANNOUNCEMENTS
  EVENTS
  TUTORIALS
}

model Email {
  id String @id @default(cuid())

  subject  String
  body     String // markdown, rendered to HTML at send time
  audience EmailAudience

  status         EmailStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?

  // Only set after delivery, records how many actually got it, not how many were targeted. Important for partial failures
  recipientCount Int?

  authorName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
}

enum EmailAudience {
  ALL
  NEW
  RETURNING
  UOA_STUDENTS
}

enum EmailStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

// Keyed by email address (not Member.id) so an opt-out survives re-registering in a later year.
model EmailAddressOptOut {
  emailAddress String @id // stored lowercased

  createdAt DateTime @default(now())
}

enum Role {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  TREASURER
  GENERAL
}

model Member {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  email     String

  registrationYear Int

  isCurrentUoaStudent Boolean

  // UoA student fields: returning eligible UoA students and new current UoA students.
  upi       String?
  studentId String?

  // Only for current UoA students.
  faculty        String[]
  programmeType  ProgrammeType?
  majors         String[]
  yearsRemaining Int?

  // Only for non-current UoA students.
  primaryAffiliation String?
  nonUoaExcerpt      String?
  nonUoaPitch        String?

  // Final questions for everyone.
  linuxSkillLevel      LinuxSkillLevel
  potentialInvolvement PotentialInvolvement[]
  discordUsername      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, registrationYear])
  @@unique([upi, studentId, registrationYear])
}

enum LinuxSkillLevel {
  NOTHING
  AWARE_OF_EXISTENCE
  BEGINNER_USER
  REGULAR_USER
  POWER_USER
  CONTRIBUTOR
}

enum PotentialInvolvement {
  ATTENDING
  SPEAKING
  EXECUTIVE
  PROJECTS
}

enum ProgrammeType {
  TFC_PRE_UNI
  BACHELOR
  MASTER
  PHD
  OTHER
}
