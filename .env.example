# Use this exact URL for local development. 
# It points to your own local Postgres container, not a shared production database. 
DATABASE_URL="postgresql://lug_user:lug_password@localhost:5432/lug_dev"
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Generate your own: openssl rand -base64 32
AUTH_SECRET="replace-me-run-openssl-rand-base64-32"

# Local seed admin (pnpm db:seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="User"
SEED_ADMIN_ROLE="PRESIDENT"